# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
*.egg-info/
.venv/
venv/

# Run outputs -- regenerable, and can get large (scripts default to results/)
results/
# ...except the committed results of the experiments (written by export_results.py)
!experiments/*/*/results/

# Model checkpoints (tracked deliberately only where small)
*.ckpt

# Local editor / OS
.vscode/
.idea/
.DS_Store

# toy-example checkpoints and per-figure run artefacts (regenerated by oz/fig1_toy_example.py)
checkpoints/toy/
runs/

# experiment outputs written by run.sh (each dir ships an empty placeholder)
experiments/*/*/outputs/*
!experiments/*/*/outputs/.gitkeep
!experiments/*/*/outputs/.gitignore

# MNIST checkpoints are downloaded (or, for the classifier, trained) on first use
experiments/mnist/checkpoints/*.pt
experiments/mnist/checkpoints/*.pth
